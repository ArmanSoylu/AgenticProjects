# Copy to .env and fill in. .env is gitignored.
gemini_api_key=

# Optional overrides.
# ChromaDB location. docker-compose sets this to /app/agent_memory_db.
# AGENT_DB_PATH=C:/Agents/agent_memory_db

# Which Gemini model each entry in the chat model picker maps to.
# MODEL_FLASH_LITE=gemini-3.5-flash-lite
# MODEL_FLASH=gemini-3.5-flash
# MODEL_PRO=gemini-pro-latest
